# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (อย่า commit .env)
# cp .env.example .env

# การเชื่อมต่อ MySQL (ค่านี้ตรงกับ docker-compose.yml สำหรับ dev)
DATABASE_URL="mysql://appuser:apppass@localhost:3306/retireplan"

# ความลับสำหรับ sign JWT — เปลี่ยนเป็นข้อความสุ่มยาวๆ ของคุณเอง
JWT_SECRET="replace-with-a-long-random-secret"
